<Window x:Class="JointBench.ProductionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JointBench Production" Height="820" Width="1220"
        MinHeight="720" MinWidth="1080"
        Background="#F4F6F8">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#1E5AA7" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#174984" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#9B1C1C" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#203040" />
            <Setter Property="BorderBrush" Value="#B9C3D2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#BCC7D5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitleText" Text="JointBench Production" FontSize="24" FontWeight="SemiBold" Foreground="#16202A" />
                <TextBlock x:Name="SubtitleText" Text="Ti5 TwinCAT ADS station" FontSize="13" Foreground="#5D6B7C" Margin="1,3,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="LanguageCombo" Width="132" SelectedIndex="0" SelectionChanged="LanguageCombo_SelectionChanged" Margin="0,0,8,0">
                    <ComboBoxItem Content="中文" Tag="zh-CN" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                </ComboBox>
                <Border Background="#E8F2E8" BorderBrush="#96C69A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="EnvironmentBadge" Text="Environment" Foreground="#244C2A" FontWeight="SemiBold" />
                </Border>
                <Border Background="#FFF6E6" BorderBrush="#D8B15E" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="AdsBadge" Text="ADS pending" Foreground="#6A4A00" FontWeight="SemiBold" />
                </Border>
                <Border Background="#F3EDED" BorderBrush="#CFB4B4" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <TextBlock x:Name="MotionBadge" Text="Motion locked" Foreground="#682D2D" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock x:Name="WorkflowHeader" Text="Workflow" FontSize="16" FontWeight="SemiBold" Foreground="#16202A" Margin="0,0,0,12" />
                    <TextBlock x:Name="Workflow1" Text="1  Environment" FontSize="14" Foreground="#203040" Margin="0,8,0,0" />
                    <TextBlock x:Name="Workflow2" Text="2  ESI import" FontSize="14" Foreground="#203040" Margin="0,14,0,0" />
                    <TextBlock x:Name="Workflow3" Text="3  Prepare TwinCAT" FontSize="14" Foreground="#203040" Margin="0,14,0,0" />
                    <TextBlock x:Name="Workflow4" Text="4  Scan Ti5" FontSize="14" Foreground="#203040" Margin="0,14,0,0" />
                    <TextBlock x:Name="Workflow5" Text="5  ADS symbols" FontSize="14" Foreground="#203040" Margin="0,14,0,0" />
                    <Separator Margin="0,18,0,18" />
                    <TextBlock x:Name="Workflow6" Text="Enable only" FontSize="14" Foreground="#6B7280" Margin="0,0,0,10" />
                    <TextBlock x:Name="Workflow7" Text="1deg step" FontSize="14" Foreground="#6B7280" Margin="0,0,0,10" />
                    <TextBlock x:Name="Workflow8" Text="5deg acceptance" FontSize="14" Foreground="#6B7280" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock x:Name="ReadinessHeader" Text="Station Readiness" FontSize="16" FontWeight="SemiBold" Foreground="#16202A" />
                            <TextBlock x:Name="PreflightSummary" Text="Not checked" FontSize="13" Foreground="#5D6B7C" Margin="0,4,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RunPreflightButton" Content="Run Preflight" Click="RunPreflightButton_Click" Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="AutomationSmokeButton" Content="Automation Smoke" Click="AutomationSmokeButton_Click" Style="{StaticResource SecondaryButton}" />
                                <Button x:Name="ScanSpikeButton" Content="Scan Ti5" Click="ScanSpikeButton_Click" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock x:Name="EsiHeader" Text="ESI" FontSize="16" FontWeight="SemiBold" Foreground="#16202A" />
                            <TextBlock x:Name="EsiSummary" Text="No file selected" FontSize="13" Foreground="#5D6B7C" Margin="0,4,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ImportEsiButton" Content="Import ESI" Click="ImportEsiButton_Click" Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="PrepareTwinCatButton" Content="Prepare TwinCAT" Click="PrepareTwinCatButton_Click" Style="{StaticResource SecondaryButton}" />
                                <CheckBox x:Name="ActivateTwinCatCheckBox" Content="Activate" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,12,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock x:Name="AmsLabel" Text="AMS Net ID" FontWeight="SemiBold" Foreground="#203040" />
                            <TextBox x:Name="AmsNetIdBox" Text="127.0.0.1.1.1" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock x:Name="PortLabel" Text="Port" FontWeight="SemiBold" Foreground="#203040" />
                            <TextBox x:Name="AdsPortBox" Text="851" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock x:Name="PrefixLabel" Text="Symbol Prefix" FontWeight="SemiBold" Foreground="#203040" />
                            <TextBox x:Name="SymbolPrefixBox" Text="MAIN.stJointBench" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="CheckAdsSymbolsButton" Grid.Column="3" Content="Check Symbols" Click="CheckAdsSymbolsButton_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TestHeader" Text="Production Test" FontSize="16" FontWeight="SemiBold" Foreground="#16202A" />
                        <Grid Grid.Row="1" Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StationDirBox" Text="data\stations\ti5_ads" />
                            <Button x:Name="StartTestButton" Grid.Column="1" Content="Start Test" Click="StartTestButton_Click" Style="{StaticResource DangerButton}" Margin="10,0,8,0" />
                            <Button x:Name="OpenReportButton" Grid.Column="2" Content="Open Report" Click="OpenReportButton_Click" Style="{StaticResource SecondaryButton}" Margin="0" />
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <CheckBox x:Name="EStopCheckBox" Content="E-stop ready" />
                            <CheckBox x:Name="FixtureCheckBox" Content="Fixture ready" />
                            <CheckBox x:Name="PowerLimitCheckBox" Content="Current-limited power" />
                            <TextBlock x:Name="LiveStatusText" Text="Idle" Foreground="#5D6B7C" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="EventHeader" Text="Event Output" FontSize="16" FontWeight="SemiBold" Foreground="#16202A" Margin="0,0,0,10" />
                        <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="13" Background="#0F1720" Foreground="#DCE7F5"
                                 BorderThickness="0" Padding="12" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
