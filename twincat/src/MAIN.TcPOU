<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="MAIN" PouType="Program">
    <Declaration><![CDATA[
PROGRAM MAIN
VAR
    stJointBench : ST_JointBenchAds := (
        sDeviceName := 'Ti5 Harmonic Joint',
        nVendorId := 0,
        nProductCode := 0,
        nRevision := 0
    );
    (* Link these top-level placeholders to the Ti5 EtherCAT PDOs after scanning the slave.
       Keep MAIN.stJointBench as the ADS surface consumed by JointBench. *)
    nTi5Statusword AT %I* : UINT;
    nTi5ActualPosition AT %I* : DINT;
    nTi5ActualVelocity AT %I* : DINT;
    nTi5ActualTorqueOrCurrent AT %I* : INT;
    nTi5ErrorCode AT %I* : UINT;
    nTi5TemperatureRaw AT %I* : INT;
    nTi5Controlword AT %Q* : UINT;
    nTi5ModeOfOperation AT %Q* : SINT;
    nTi5TargetPosition AT %Q* : DINT;
    (* Runtime configuration written by the C# station software from the local station YAML. *)
    fTi5MinPositionDeg : LREAL := -6.0;
    fTi5MaxPositionDeg : LREAL := 6.0;
    fTi5MaxVelocityDps : LREAL := 30.0;
    fTi5MaxCurrentA : LREAL := 3.0;
    fTi5MaxTemperatureC : LREAL := 60.0;
    fTi5MaxFollowingErrorDeg : LREAL := 2.0;
    nTi5EncoderCountsPerRev : DINT := 524288;
    fTi5GearRatio : LREAL := 1.0;
    nTi5PositionDirection : DINT := 1;
    fTi5ZeroOffsetDeg : LREAL := 0.0;
    fTi5CurrentScaleAPerUnit : LREAL := 1.0;
    fTi5TemperatureScaleCPerUnit : LREAL := 1.0;
    stTi5In : ST_Ti5CiA402PdoInput;
    stTi5Out : ST_Ti5CiA402PdoOutput;
    fbJointBenchAxis : FB_JointBenchAxis;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
stTi5In.nStatusword := nTi5Statusword;
stTi5In.nActualPosition := nTi5ActualPosition;
stTi5In.nActualVelocity := nTi5ActualVelocity;
stTi5In.nActualTorqueOrCurrent := nTi5ActualTorqueOrCurrent;
stTi5In.nErrorCode := nTi5ErrorCode;
stTi5In.nTemperatureRaw := nTi5TemperatureRaw;

fbJointBenchAxis(
    stIf := stJointBench,
    stDriveIn := stTi5In,
    stDriveOut := stTi5Out,
    fMinPositionDeg := fTi5MinPositionDeg,
    fMaxPositionDeg := fTi5MaxPositionDeg,
    fMaxVelocityDps := fTi5MaxVelocityDps,
    fMaxCurrentA := fTi5MaxCurrentA,
    fMaxTemperatureC := fTi5MaxTemperatureC,
    fMaxFollowingErrorDeg := fTi5MaxFollowingErrorDeg,
    nEncoderCountsPerRev := nTi5EncoderCountsPerRev,
    fGearRatio := fTi5GearRatio,
    nPositionDirection := nTi5PositionDirection,
    fZeroOffsetDeg := fTi5ZeroOffsetDeg,
    fCurrentScaleAPerUnit := fTi5CurrentScaleAPerUnit,
    fTemperatureScaleCPerUnit := fTi5TemperatureScaleCPerUnit
);

nTi5Controlword := stTi5Out.nControlword;
nTi5ModeOfOperation := stTi5Out.nModeOfOperation;
nTi5TargetPosition := stTi5Out.nTargetPosition;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
