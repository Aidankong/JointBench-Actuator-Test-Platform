<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="MAIN" PouType="Program">
    <Declaration><![CDATA[
PROGRAM MAIN
VAR
    stJointBench : ST_JointBenchAds := (
        sDeviceName := 'Ti5 Harmonic Joint',
        nVendorId := 0,
        nProductCode := 0,
        nRevision := 0
    );
    (* Link these placeholder structures to the Ti5 EtherCAT PDOs after scanning the slave.
       Keep MAIN.stJointBench as the ADS surface consumed by JointBench. *)
    stTi5In AT %I* : ST_Ti5CiA402PdoInput;
    stTi5Out AT %Q* : ST_Ti5CiA402PdoOutput;
    fbJointBenchAxis : FB_JointBenchAxis;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
fbJointBenchAxis(
    stIf := stJointBench,
    stDriveIn := stTi5In,
    stDriveOut := stTi5Out
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
